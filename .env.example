# Copy to .env.local for local development. On Netlify, set these under
# Site configuration -> Environment variables instead.

# Turso database. Leave both unset locally to use a SQLite file (local.db).
TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN="replace-with-turso-token"

DASHBOARD_PASSWORD="replace-with-a-strong-password"
DASHBOARD_SESSION_SECRET="replace-with-a-long-random-secret"
